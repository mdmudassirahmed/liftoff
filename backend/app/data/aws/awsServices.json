{
  "_comment": "AWS service catalog: CloudFormation resource types, required/optional properties and defaults. Served by /api/agents/aws/cf-schema.",
  "services": [
    {
      "id": "aws-lambda",
      "name": "Lambda Function",
      "resourceType": "AWS::Lambda::Function",
      "category": "Compute",
      "iconPath": "mdi:function",
      "description": "Serverless event-driven compute",
      "cfProperties": {
        "required": ["Code", "Role"],
        "optional": ["FunctionName", "Handler", "Runtime", "Environment", "Timeout", "MemorySize", "VpcConfig", "Layers", "ReservedConcurrentExecutions", "TracingConfig"]
      },
      "defaultProperties": {
        "Runtime": "python3.14",
        "Handler": "lambda_function.lambda_handler",
        "Timeout": 60,
        "MemorySize": 128
      }
    },
    {
      "id": "aws-ec2-instance",
      "name": "EC2 Instance",
      "resourceType": "AWS::EC2::Instance",
      "category": "Compute",
      "iconPath": "mdi:server",
      "description": "Virtual machine in the cloud",
      "cfProperties": {
        "required": ["ImageId"],
        "optional": ["InstanceType", "KeyName", "SubnetId", "SecurityGroupIds", "IamInstanceProfile", "UserData", "EbsOptimized", "Monitoring", "Tags"]
      },
      "defaultProperties": {
        "InstanceType": "t3.medium",
        "EbsOptimized": true,
        "Monitoring": true
      }
    },
    {
      "id": "aws-autoscaling-group",
      "name": "Auto Scaling Group",
      "resourceType": "AWS::AutoScaling::AutoScalingGroup",
      "category": "Compute",
      "iconPath": "mdi:auto-fix",
      "description": "Automatically scale EC2 capacity",
      "cfProperties": {
        "required": ["MinSize", "MaxSize"],
        "optional": ["DesiredCapacity", "LaunchTemplate", "VPCZoneIdentifier", "TargetGroupARNs", "HealthCheckType", "HealthCheckGracePeriod", "Tags"]
      },
      "defaultProperties": {
        "MinSize": "1",
        "MaxSize": "4",
        "DesiredCapacity": "2",
        "HealthCheckType": "ELB",
        "HealthCheckGracePeriod": 300
      }
    },
    {
      "id": "aws-ecs-cluster",
      "name": "ECS Cluster",
      "resourceType": "AWS::ECS::Cluster",
      "category": "Compute",
      "iconPath": "mdi:docker",
      "description": "Elastic Container Service cluster",
      "cfProperties": {
        "required": [],
        "optional": ["ClusterName", "ClusterSettings", "Configuration", "CapacityProviders", "DefaultCapacityProviderStrategy", "Tags"]
      },
      "defaultProperties": {
        "ClusterSettings": [{"Name": "containerInsights", "Value": "enabled"}]
      }
    },
    {
      "id": "aws-ecs-task-definition",
      "name": "ECS Task Definition",
      "resourceType": "AWS::ECS::TaskDefinition",
      "category": "Compute",
      "iconPath": "mdi:clipboard-list",
      "description": "Blueprint for ECS container tasks",
      "cfProperties": {
        "required": ["ContainerDefinitions"],
        "optional": ["Family", "NetworkMode", "RequiresCompatibilities", "Cpu", "Memory", "ExecutionRoleArn", "TaskRoleArn", "Volumes", "Tags"]
      },
      "defaultProperties": {
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": ["FARGATE"],
        "Cpu": "256",
        "Memory": "512"
      }
    },
    {
      "id": "aws-eks-cluster",
      "name": "EKS Cluster",
      "resourceType": "AWS::EKS::Cluster",
      "category": "Compute",
      "iconPath": "mdi:kubernetes",
      "description": "Managed Kubernetes cluster",
      "cfProperties": {
        "required": ["RoleArn", "ResourcesVpcConfig"],
        "optional": ["Name", "Version", "Logging", "KubernetesNetworkConfig", "EncryptionConfig", "Tags"]
      },
      "defaultProperties": {
        "Version": "1.30",
        "Logging": {
          "ClusterLogging": {
            "EnabledTypes": [
              {"Type": "api"},
              {"Type": "audit"}
            ]
          }
        }
      }
    },
    {
      "id": "aws-s3-bucket",
      "name": "S3 Bucket",
      "resourceType": "AWS::S3::Bucket",
      "category": "Storage",
      "iconPath": "mdi:bucket",
      "description": "Object storage with unlimited scalability",
      "cfProperties": {
        "required": [],
        "optional": ["BucketName", "AccessControl", "BucketEncryption", "VersioningConfiguration", "PublicAccessBlockConfiguration", "LoggingConfiguration", "LifecycleConfiguration", "Tags"]
      },
      "defaultProperties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "VersioningConfiguration": {"Status": "Enabled"},
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [{"ServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]
        }
      }
    },
    {
      "id": "aws-efs-filesystem",
      "name": "EFS File System",
      "resourceType": "AWS::EFS::FileSystem",
      "category": "Storage",
      "iconPath": "mdi:folder-network",
      "description": "Managed NFS elastic file system",
      "cfProperties": {
        "required": [],
        "optional": ["Encrypted", "KmsKeyId", "PerformanceMode", "ThroughputMode", "BackupPolicy", "LifecyclePolicies", "FileSystemTags"]
      },
      "defaultProperties": {
        "Encrypted": true,
        "PerformanceMode": "generalPurpose",
        "ThroughputMode": "bursting",
        "BackupPolicy": {"Status": "ENABLED"}
      }
    },
    {
      "id": "aws-rds-instance",
      "name": "RDS DB Instance",
      "resourceType": "AWS::RDS::DBInstance",
      "category": "Databases",
      "iconPath": "mdi:database",
      "description": "Managed relational database instance",
      "cfProperties": {
        "required": ["DBInstanceClass", "Engine"],
        "optional": ["DBInstanceIdentifier", "MasterUsername", "MasterUserPassword", "DBName", "StorageEncrypted", "KmsKeyId", "MultiAZ", "BackupRetentionPeriod", "DeletionProtection", "DBSubnetGroupName", "VPCSecurityGroups", "Tags"]
      },
      "defaultProperties": {
        "DBInstanceClass": "db.t3.medium",
        "Engine": "postgres",
        "EngineVersion": "15.4",
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "MultiAZ": true,
        "BackupRetentionPeriod": 7,
        "DeletionProtection": true
      }
    },
    {
      "id": "aws-rds-cluster",
      "name": "RDS DB Cluster (Aurora)",
      "resourceType": "AWS::RDS::DBCluster",
      "category": "Databases",
      "iconPath": "mdi:database-check",
      "description": "Aurora managed relational database cluster",
      "cfProperties": {
        "required": ["Engine"],
        "optional": ["DBClusterIdentifier", "MasterUsername", "MasterUserPassword", "DatabaseName", "StorageEncrypted", "KmsKeyId", "BackupRetentionPeriod", "DeletionProtection", "DBSubnetGroupName", "VpcSecurityGroupIds", "ServerlessV2ScalingConfiguration", "Tags"]
      },
      "defaultProperties": {
        "Engine": "aurora-mysql",
        "EngineVersion": "8.0.mysql_aurora.3.04.0",
        "StorageEncrypted": true,
        "BackupRetentionPeriod": 7,
        "DeletionProtection": true
      }
    },
    {
      "id": "aws-dynamodb-table",
      "name": "DynamoDB Table",
      "resourceType": "AWS::DynamoDB::Table",
      "category": "Databases",
      "iconPath": "mdi:table",
      "description": "Serverless NoSQL key-value and document database",
      "cfProperties": {
        "required": ["KeySchema", "AttributeDefinitions"],
        "optional": ["TableName", "BillingMode", "ProvisionedThroughput", "GlobalSecondaryIndexes", "LocalSecondaryIndexes", "SSESpecification", "PointInTimeRecoverySpecification", "StreamSpecification", "Tags"]
      },
      "defaultProperties": {
        "BillingMode": "PAY_PER_REQUEST",
        "SSESpecification": {"SSEEnabled": true},
        "PointInTimeRecoverySpecification": {"PointInTimeRecoveryEnabled": true}
      }
    },
    {
      "id": "aws-dynamodb-global-table",
      "name": "DynamoDB Global Table",
      "resourceType": "AWS::DynamoDB::GlobalTable",
      "category": "Databases",
      "iconPath": "mdi:table-sync",
      "description": "Multi-region active-active DynamoDB table",
      "cfProperties": {
        "required": ["KeySchema", "AttributeDefinitions", "Replicas"],
        "optional": ["TableName", "BillingMode", "WriteProvisionedThroughputSettings", "GlobalSecondaryIndexes", "LocalSecondaryIndexes", "SSESpecification", "StreamSpecification", "TimeToLiveSpecification"]
      },
      "defaultProperties": {
        "BillingMode": "PAY_PER_REQUEST",
        "SSESpecification": {"SSEEnabled": true}
      }
    },
    {
      "id": "aws-elasticache-cluster",
      "name": "ElastiCache Cluster",
      "resourceType": "AWS::ElastiCache::CacheCluster",
      "category": "Databases",
      "iconPath": "mdi:memory",
      "description": "In-memory caching service (Redis/Memcached)",
      "cfProperties": {
        "required": ["CacheNodeType", "Engine", "NumCacheNodes"],
        "optional": ["ClusterName", "EngineVersion", "CacheSubnetGroupName", "VpcSecurityGroupIds", "SnapshotRetentionLimit", "TransitEncryptionEnabled", "AtRestEncryptionEnabled", "Tags"]
      },
      "defaultProperties": {
        "CacheNodeType": "cache.t3.medium",
        "Engine": "redis",
        "EngineVersion": "7.0",
        "NumCacheNodes": 1,
        "SnapshotRetentionLimit": 7
      }
    },
    {
      "id": "aws-redshift-cluster",
      "name": "Redshift Cluster",
      "resourceType": "AWS::Redshift::Cluster",
      "category": "Analytics",
      "iconPath": "mdi:warehouse",
      "description": "Petabyte-scale data warehouse",
      "cfProperties": {
        "required": ["ClusterType", "NodeType", "MasterUsername", "MasterUserPassword", "DBName"],
        "optional": ["ClusterIdentifier", "NumberOfNodes", "Encrypted", "KmsKeyId", "ClusterSubnetGroupName", "VpcSecurityGroupIds", "AutomatedSnapshotRetentionPeriod", "Tags"]
      },
      "defaultProperties": {
        "ClusterType": "multi-node",
        "NodeType": "ra3.xlplus",
        "NumberOfNodes": 2,
        "Encrypted": true,
        "AutomatedSnapshotRetentionPeriod": 7
      }
    },
    {
      "id": "aws-bedrock-agent",
      "name": "Bedrock Agent",
      "resourceType": "AWS::Bedrock::Agent",
      "category": "AI",
      "iconPath": "mdi:brain",
      "description": "Generative AI agent powered by Amazon Bedrock",
      "cfProperties": {
        "required": ["AgentName", "AgentResourceRoleArn", "FoundationModel"],
        "optional": ["Description", "Instruction", "IdleSessionTTLInSeconds", "CustomerEncryptionKeyArn", "ActionGroups", "KnowledgeBases", "Tags"]
      },
      "defaultProperties": {
        "FoundationModel": "amazon.nova-pro-v1:0",
        "IdleSessionTTLInSeconds": 1800
      }
    },
    {
      "id": "aws-sagemaker-notebook",
      "name": "SageMaker Notebook Instance",
      "resourceType": "AWS::SageMaker::NotebookInstance",
      "category": "AI",
      "iconPath": "mdi:robot",
      "description": "Managed Jupyter notebooks for ML development",
      "cfProperties": {
        "required": ["InstanceType", "RoleArn"],
        "optional": ["NotebookInstanceName", "VolumeSizeInGB", "KmsKeyId", "SubnetId", "SecurityGroupIds", "DirectInternetAccess", "LifecycleConfigName", "Tags"]
      },
      "defaultProperties": {
        "InstanceType": "ml.t3.medium",
        "VolumeSizeInGB": 20,
        "DirectInternetAccess": "Disabled"
      }
    },
    {
      "id": "aws-iam-role",
      "name": "IAM Role",
      "resourceType": "AWS::IAM::Role",
      "category": "Security",
      "iconPath": "mdi:account-key",
      "description": "Identity with permissions for AWS services and users",
      "cfProperties": {
        "required": ["AssumeRolePolicyDocument"],
        "optional": ["RoleName", "Description", "ManagedPolicyArns", "Policies", "MaxSessionDuration", "PermissionsBoundary", "Path", "Tags"]
      },
      "defaultProperties": {
        "MaxSessionDuration": 3600
      }
    },
    {
      "id": "aws-secretsmanager-secret",
      "name": "Secrets Manager Secret",
      "resourceType": "AWS::SecretsManager::Secret",
      "category": "Security",
      "iconPath": "mdi:safe",
      "description": "Securely store and rotate credentials and secrets",
      "cfProperties": {
        "required": [],
        "optional": ["Name", "Description", "KmsKeyId", "SecretString", "GenerateSecretString", "ReplicaRegions", "Tags"]
      },
      "defaultProperties": {
        "GenerateSecretString": {
          "PasswordLength": 32,
          "ExcludeCharacters": "\"@/\\"
        }
      }
    },
    {
      "id": "aws-kms-key",
      "name": "KMS Key",
      "resourceType": "AWS::KMS::Key",
      "category": "Security",
      "iconPath": "mdi:key",
      "description": "Managed encryption keys for data protection",
      "cfProperties": {
        "required": ["KeyPolicy"],
        "optional": ["Description", "Enabled", "EnableKeyRotation", "KeySpec", "KeyUsage", "MultiRegion", "PendingWindowInDays", "Tags"]
      },
      "defaultProperties": {
        "EnableKeyRotation": true,
        "Enabled": true,
        "KeySpec": "SYMMETRIC_DEFAULT",
        "KeyUsage": "ENCRYPT_DECRYPT",
        "PendingWindowInDays": 30
      }
    },
    {
      "id": "aws-sqs-queue",
      "name": "SQS Queue",
      "resourceType": "AWS::SQS::Queue",
      "category": "Integration",
      "iconPath": "mdi:tray-full",
      "description": "Fully managed message queuing service",
      "cfProperties": {
        "required": [],
        "optional": ["QueueName", "FifoQueue", "ContentBasedDeduplication", "KmsMasterKeyId", "VisibilityTimeout", "MessageRetentionPeriod", "MaximumMessageSize", "ReceiveMessageWaitTimeSeconds", "RedrivePolicy", "Tags"]
      },
      "defaultProperties": {
        "VisibilityTimeout": 30,
        "MessageRetentionPeriod": 345600,
        "ReceiveMessageWaitTimeSeconds": 20
      }
    },
    {
      "id": "aws-sns-topic",
      "name": "SNS Topic",
      "resourceType": "AWS::SNS::Topic",
      "category": "Integration",
      "iconPath": "mdi:bell-ring",
      "description": "Pub/sub messaging and fan-out notifications",
      "cfProperties": {
        "required": [],
        "optional": ["TopicName", "DisplayName", "FifoTopic", "ContentBasedDeduplication", "KmsMasterKeyId", "Subscription", "Tags"]
      },
      "defaultProperties": {
        "FifoTopic": false
      }
    },
    {
      "id": "aws-eventbridge-rule",
      "name": "EventBridge Rule",
      "resourceType": "AWS::Events::Rule",
      "category": "Integration",
      "iconPath": "mdi:calendar-clock",
      "description": "Event-driven rules for routing events to targets",
      "cfProperties": {
        "required": [],
        "optional": ["Name", "Description", "EventBusName", "EventPattern", "ScheduleExpression", "State", "Targets", "RoleArn"]
      },
      "defaultProperties": {
        "State": "ENABLED"
      }
    },
    {
      "id": "aws-stepfunctions-statemachine",
      "name": "Step Functions State Machine",
      "resourceType": "AWS::StepFunctions::StateMachine",
      "category": "Integration",
      "iconPath": "mdi:state-machine",
      "description": "Visual workflow orchestration for distributed applications",
      "cfProperties": {
        "required": ["RoleArn"],
        "optional": ["StateMachineName", "StateMachineType", "DefinitionString", "DefinitionS3Location", "LoggingConfiguration", "TracingConfiguration", "Tags"]
      },
      "defaultProperties": {
        "StateMachineType": "STANDARD",
        "TracingConfiguration": {"Enabled": true}
      }
    },
    {
      "id": "aws-apigateway-restapi",
      "name": "API Gateway REST API",
      "resourceType": "AWS::ApiGateway::RestApi",
      "category": "Integration",
      "iconPath": "mdi:api",
      "description": "Managed REST API gateway",
      "cfProperties": {
        "required": ["Name"],
        "optional": ["Description", "EndpointConfiguration", "Policy", "MinimumCompressionSize", "BinaryMediaTypes", "FailOnWarnings", "Tags"]
      },
      "defaultProperties": {
        "EndpointConfiguration": {"Types": ["REGIONAL"]},
        "MinimumCompressionSize": 1024
      }
    },
    {
      "id": "aws-apigatewayv2-api",
      "name": "API Gateway HTTP API",
      "resourceType": "AWS::ApiGatewayV2::Api",
      "category": "Integration",
      "iconPath": "mdi:web",
      "description": "Low-latency HTTP and WebSocket APIs",
      "cfProperties": {
        "required": ["Name", "ProtocolType"],
        "optional": ["Description", "CorsConfiguration", "DisableExecuteApiEndpoint", "RouteKey", "Target", "Tags"]
      },
      "defaultProperties": {
        "ProtocolType": "HTTP",
        "DisableExecuteApiEndpoint": false
      }
    },
    {
      "id": "aws-glue-job",
      "name": "Glue Job",
      "resourceType": "AWS::Glue::Job",
      "category": "Analytics",
      "iconPath": "mdi:puzzle",
      "description": "Serverless ETL data integration service",
      "cfProperties": {
        "required": ["Command", "Role"],
        "optional": ["Name", "Description", "GlueVersion", "MaxCapacity", "NumberOfWorkers", "WorkerType", "DefaultArguments", "Connections", "SecurityConfiguration", "Tags"]
      },
      "defaultProperties": {
        "GlueVersion": "4.0",
        "WorkerType": "G.1X",
        "NumberOfWorkers": 2
      }
    },
    {
      "id": "aws-kinesis-stream",
      "name": "Kinesis Stream",
      "resourceType": "AWS::Kinesis::Stream",
      "category": "Analytics",
      "iconPath": "mdi:waves",
      "description": "Real-time data streaming at scale",
      "cfProperties": {
        "required": [],
        "optional": ["Name", "ShardCount", "StreamModeDetails", "RetentionPeriodHours", "StreamEncryption", "Tags"]
      },
      "defaultProperties": {
        "ShardCount": 1,
        "RetentionPeriodHours": 24,
        "StreamEncryption": {"EncryptionType": "KMS"}
      }
    },
    {
      "id": "aws-athena-workgroup",
      "name": "Athena WorkGroup",
      "resourceType": "AWS::Athena::WorkGroup",
      "category": "Analytics",
      "iconPath": "mdi:magnify",
      "description": "Interactive SQL query service for S3 data",
      "cfProperties": {
        "required": ["Name"],
        "optional": ["Description", "State", "WorkGroupConfiguration", "RecursiveDeleteOption", "Tags"]
      },
      "defaultProperties": {
        "State": "ENABLED",
        "WorkGroupConfiguration": {
          "EnforceWorkGroupConfiguration": true,
          "ResultConfiguration": {"EncryptionConfiguration": {"EncryptionOption": "SSE_S3"}}
        }
      }
    },
    {
      "id": "aws-logs-loggroup",
      "name": "CloudWatch Log Group",
      "resourceType": "AWS::Logs::LogGroup",
      "category": "Monitoring",
      "iconPath": "mdi:chart-line",
      "description": "Centralized log storage and monitoring",
      "cfProperties": {
        "required": [],
        "optional": ["LogGroupName", "RetentionInDays", "KmsKeyId", "Tags"]
      },
      "defaultProperties": {
        "RetentionInDays": 365
      }
    },
    {
      "id": "aws-alb",
      "name": "Application Load Balancer",
      "resourceType": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "category": "Networking",
      "iconPath": "mdi:scale-balance",
      "description": "Layer-7 HTTP/HTTPS load balancer",
      "cfProperties": {
        "required": ["Subnets"],
        "optional": ["Name", "Scheme", "Type", "SecurityGroups", "LoadBalancerAttributes", "IpAddressType", "Tags"]
      },
      "defaultProperties": {
        "Scheme": "internal",
        "Type": "application",
        "IpAddressType": "ipv4"
      }
    },
    {
      "id": "aws-cloudfront-distribution",
      "name": "CloudFront Distribution",
      "resourceType": "AWS::CloudFront::Distribution",
      "category": "Networking",
      "iconPath": "mdi:earth",
      "description": "Global CDN for low-latency content delivery",
      "cfProperties": {
        "required": ["DistributionConfig"],
        "optional": ["Tags"]
      },
      "defaultProperties": {
        "DistributionConfig": {
          "Enabled": true,
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_100",
          "DefaultCacheBehavior": {
            "ViewerProtocolPolicy": "redirect-to-https",
            "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
            "Compress": true
          }
        }
      }
    },
    {
      "id": "aws-cognito-userpool",
      "name": "Cognito User Pool",
      "resourceType": "AWS::Cognito::UserPool",
      "category": "Security",
      "iconPath": "mdi:account-group",
      "description": "Managed user directory and authentication",
      "cfProperties": {
        "required": [],
        "optional": ["UserPoolName", "UsernameAttributes", "AutoVerifiedAttributes", "Policies", "MfaConfiguration", "Schema", "EmailConfiguration", "SmsConfiguration", "AdminCreateUserConfig", "AccountRecoverySetting", "UserPoolTags", "DeletionProtection"]
      },
      "defaultProperties": {
        "DeletionProtection": "ACTIVE",
        "MfaConfiguration": "OPTIONAL",
        "AutoVerifiedAttributes": ["email"],
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 12,
            "RequireUppercase": true,
            "RequireLowercase": true,
            "RequireNumbers": true,
            "RequireSymbols": true
          }
        },
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [{ "Name": "verified_email", "Priority": 1 }]
        }
      }
    }
  ],
  "categories": ["Compute", "Storage", "Databases", "AI", "Analytics", "Security", "Integration", "Monitoring", "Networking"]
}
