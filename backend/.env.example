# Liftoff backend configuration
# Copy to backend/.env and fill in. backend/.env is git-ignored - never commit it.

# --- AI features (optional) --------------------------------------------------
# Your Azure AI Foundry project endpoint. Leave empty to run without AI
# (canvas, validation, What-If and deploy still work).
# Auth is keyless: run `az login` (or use a managed identity) - no API keys.
# Format: https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=

# --- Server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Host headers accepted (comma-separated). Protects the local API from DNS rebinding.
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional shared secret. If set, the frontend must send the same value
# (VITE_API_TOKEN in frontend/.env.local). Recommended if the API is reachable
# from anywhere other than your own machine.
API_AUTH_TOKEN=

# --- IaC generation ----------------------------------------------------------
# Inject security guardrails into prompts and return a compliance report.
GUARDRAILS_ENABLED=true
# Landing-zone mode: reference existing VNets/subnets instead of creating them.
IAC_REFERENCE_EXISTING_NETWORKS=false

# --- MCP grounding servers (public, no auth) ---------------------------------
# MCP_MICROSOFT_DOCS_URL=https://learn.microsoft.com/api/mcp
# MCP_BICEP_URL=https://learn.microsoft.com/api/mcp/tools/azure-bicep-schema
# MCP_TERRAFORM_URL=https://developer.hashicorp.com/terraform/mcp-server
