# Liftoff backend configuration
# Copy to backend/.env and fill in. backend/.env is git-ignored - never commit it.

# --- AI features (optional) --------------------------------------------------
# Leave everything here empty to run without AI (canvas, validation, What-If and
# deploy still work). Configure ONE of the options below; AI_PROVIDER=auto picks
# the first one that is set, in this order.
AI_PROVIDER=auto
# Model for OpenAI-compatible providers (and the Azure OpenAI deployment fallback).
AI_MODEL=gpt-4.1

# Option 1: Azure AI Foundry agents (create them once with agents/create_agents.py).
# Keyless: `az login` or a managed identity.
# Format: https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=

# Option 2: Azure OpenAI. Keyless via `az login` unless you set the key.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Option 3: OpenAI, or any OpenAI-compatible server.
#   OpenAI:    OPENAI_API_KEY=sk-...
#   Ollama:    OPENAI_BASE_URL=http://localhost:11434/v1   AI_MODEL=llama3.1
#   LM Studio: OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Host headers accepted (comma-separated). Protects the local API from DNS rebinding.
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional shared secret. If set, the frontend must send the same value
# (VITE_API_TOKEN in frontend/.env.local). Recommended if the API is reachable
# from anywhere other than your own machine.
API_AUTH_TOKEN=

# --- IaC generation ----------------------------------------------------------
# Inject security guardrails into prompts and return a compliance report.
GUARDRAILS_ENABLED=true
# Landing-zone mode: reference existing VNets/subnets instead of creating them.
IAC_REFERENCE_EXISTING_NETWORKS=false

# --- MCP grounding servers (public, no auth) ---------------------------------
# MCP_MICROSOFT_DOCS_URL=https://learn.microsoft.com/api/mcp
# MCP_BICEP_URL=https://learn.microsoft.com/api/mcp/tools/azure-bicep-schema
# MCP_TERRAFORM_URL=https://developer.hashicorp.com/terraform/mcp-server
