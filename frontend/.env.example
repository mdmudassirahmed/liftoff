# Liftoff frontend configuration
# Copy to frontend/.env.local (git-ignored). Everything here is optional.

# Backend base URL
VITE_API_URL=http://localhost:8000

# Only if the backend sets API_AUTH_TOKEN. Note: VITE_* values are embedded in
# the built JavaScript, so treat this as an access key for a private deployment,
# not as a secret you can hide from people who can load the app.
# VITE_API_TOKEN=
