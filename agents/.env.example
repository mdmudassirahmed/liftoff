# Azure AI Foundry Project Configuration
# Copy this file to .env and fill in your values

# Required: Azure AI Foundry Project Endpoint
# Format: https://<resource>.services.ai.azure.com/api/projects/<project-name>
AZURE_AI_PROJECT_ENDPOINT=https://your-foundry.services.ai.azure.com/api/projects/your-project

# Required: Model Deployment Name (must be deployed in your Foundry project)
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1

# Required: OpenAI API Version (for conversations/responses API)
OPENAI_API_VERSION=2024-10-21

# Optional: MCP Project Connection Name
# Only required if using authenticated MCP servers (e.g., GitHub MCP)
# Create a connection in Azure AI Foundry portal first
# MCP_PROJECT_CONNECTION_NAME=github-mcp-connection

# Optional: Custom MCP Server URLs
# MCP_MICROSOFT_LEARN_URL=https://learn.microsoft.com/api/mcp
# MCP_GITHUB_URL=https://api.githubcopilot.com/mcp
